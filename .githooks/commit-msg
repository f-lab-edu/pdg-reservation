#!/bin/sh
# 커밋 메시지 형식 검사. 형식이 맞지 않으면 커밋을 중단한다.
# 규칙: docs/git-rules.md

msg_file="$1"

# '#'으로 시작하는 주석 줄과 빈 줄을 빼고 첫 줄(요약)을 가져온다.
subject=$(grep -v '^#' "$msg_file" | grep -v '^[[:space:]]*$' | sed -n '1p')

# Git이 자동으로 만드는 머지·되돌리기 메시지는 통과시킨다.
case "$subject" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

pattern='^(feat|fix|refactor|test|docs|chore|perf)(\([a-z0-9-]+\))?: .+'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "커밋 메시지 형식이 맞지 않습니다." >&2
  echo "  입력: $subject" >&2
  echo "  형식: <type>(<scope>): <요약>" >&2
  echo "  type: feat | fix | refactor | test | docs | chore | perf" >&2
  echo "  예시: feat: 환불 수수료 계산 추가" >&2
  echo "  예시: fix(payment): 금액 불일치 검증 복구" >&2
  exit 1
fi

# 요약 끝에 마침표를 찍지 않는다.
if printf '%s' "$subject" | grep -Eq '\.$'; then
  echo "요약 끝에 마침표를 찍지 않습니다." >&2
  echo "  입력: $subject" >&2
  exit 1
fi

exit 0
